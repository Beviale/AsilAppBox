<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/test_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iconHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@mipmap/parkinson_icon_black"
        app:layout_constraintEnd_toStartOf="@+id/testTitle"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/testTitle" />

    <TextView
        android:id="@+id/testTitle"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/marginLeftRightDetailHealthHistory"
        android:layout_marginTop="28dp"
        android:layout_marginRight="@dimen/marginLeftRightDetailHealthHistory"
        android:fontFamily="@font/titillium_web_bold"
        android:text="@string/stressToolTitle"
        android:textSize="@dimen/title2FontSize"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/testDescription"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="@dimen/marginLeftRightDetailHealthHistory"
        android:background="@drawable/rounded"
        android:cursorVisible="true"
        android:editable="false"
        android:elevation="10dp"
        android:fadeScrollbars="false"
        android:gravity="top"
        android:padding="10dp"
        android:scrollbarAlwaysDrawHorizontalTrack="false"
        android:scrollbarAlwaysDrawVerticalTrack="false"
        android:scrollbars="vertical"
        android:text="@string/stressToolDesc"
        android:textSize="@dimen/textSizeDoctorNotes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconHolder" />

    <ProgressBar
        android:id="@+id/test_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="50dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="50"
        android:progressTint="@color/appMainColor"
        android:scaleY="5"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/test_footer_fragment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.404"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/testDescription" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/test_footer_fragment"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent">

    </androidx.fragment.app.FragmentContainerView>


</androidx.constraintlayout.widget.ConstraintLayout>