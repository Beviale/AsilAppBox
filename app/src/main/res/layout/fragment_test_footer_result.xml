<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <Button
        android:id="@+id/confirm_result_button"
        android:layout_width="150dp"
        android:layout_height="@dimen/buttonsLoginHeight"
        android:layout_marginEnd="@dimen/marginLeftRightDetailHealthHistory"
        android:backgroundTint="@color/buttonsColor"
        android:text="@string/confirmTestResultButtonLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/cancel_result_button"
        android:layout_width="150dp"
        android:layout_height="@dimen/buttonsLoginHeight"
        android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
        android:backgroundTint="@color/buttonsColor"
        android:text="@string/cancelTestResultButtonLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>