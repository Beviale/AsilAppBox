<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <Button android:id="@+id/confirm_result_button"
        android:layout_width="150dp"
        android:layout_height="@dimen/buttonsLoginHeight"
        android:layout_marginEnd="@dimen/marginLeftRightDetailHealthHistory"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/buttonsColor"
        android:text="@string/confirmTestResultButtonLabel"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/stress_test_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stressToolDescription"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/cancel_result_button"
        android:layout_width="150dp"
        android:layout_height="@dimen/buttonsLoginHeight"
        android:layout_marginStart="@dimen/marginLeftRightDetailHealthHistory"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/buttonsColor"
        android:text="@string/cancelTestResultButtonLabel"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/stress_test_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stressToolDescription"
        app:layout_constraintVertical_bias="1.0" />

</LinearLayout>
